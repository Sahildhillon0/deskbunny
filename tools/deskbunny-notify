#!/bin/sh
# Show a notification on the DeskBunny (the app must be running).
#   deskbunny-notify "Backup done" "42 GB in 12 min"
#   make && deskbunny-notify "Build passed" || deskbunny-notify "Build FAILED"
# Contract: docs/ARCHITECTURE.md, "Local endpoint".
title=${1:?usage: deskbunny-notify TITLE [BODY] [APP]}
body=${2:-}
app=${3:-script}
json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n\t' '  '; }
curl -s -m 2 -H 'X-DeskBunny: 1' -H 'Content-Type: application/json' \
  --data "{\"title\":\"$(json_escape "$title")\",\"body\":\"$(json_escape "$body")\",\"app\":\"$(json_escape "$app")\"}" \
  http://127.0.0.1:47807/notify >/dev/null || {
  echo "deskbunny-notify: DeskBunny is not running" >&2
  exit 1
}
